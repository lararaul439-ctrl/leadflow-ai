# LeadFlow AI does NOT read this file. n8n keeps credentials inside n8n (Credentials menu),
# and the workflow JSON files only contain placeholders. This is a checklist of the values you
# need to have ready when you import the workflows (see "How to set it up" in README.md).
# Never put real values in a file that is committed to git.

# API key of an OpenAI-compatible model provider (Groq's free tier is enough for fictional data).
# Goes into an n8n "Header Auth" credential: header name "Authorization", value "Bearer <key>".
GROQ_API_KEY=

# Address of the TEST Gmail account. Goes into the sender filter of the "Gmail Trigger" node.
GMAIL_TEST_ADDRESS=

# ID of your Google Sheets document (the long string in its URL).
# Selected in the Google Sheets nodes; the tabs "solicitudes", "errores" and "bloqueos" must exist
# (headers are listed in README.md, "How to set it up").
GOOGLE_SHEET_ID=

# ID of the imported "LeadFlow AI - Errores" workflow.
# Selected in the settings of the main workflow as its error workflow.
N8N_ERROR_WORKFLOW_ID=
